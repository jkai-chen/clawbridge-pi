{
	"name": "pi-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/telemetry",
		"packages/ai",
		"packages/agent"
	],
	"scripts": {
		"clean": "npm run clean --workspaces",
		"build": "npm --prefix packages/telemetry run build && npm --prefix packages/ai run build:offline && npm --prefix packages/agent run build",
		"check": "tsc --noEmit",
		"test": "npm run test --workspaces --if-present"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"shx": "0.3.4",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"version": "0.0.3",
	"overrides": {
		"protobufjs": "7.6.6"
	}
}
